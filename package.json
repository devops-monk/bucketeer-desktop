{
  "name": "bucketeer-desktop",
  "version": "0.3.0",
  "description": "An open-source desktop client for Amazon S3 and S3-compatible storage",
  "productName": "Bucketeer",
  "main": "./out/main/index.js",
  "desktopName": "bucketeer.desktop",
  "author": "devops-monk",
  "license": "Apache-2.0",
  "homepage": "https://github.com/devops-monk/bucketeer-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win",
    "pack:linux": "npm run build && electron-builder --linux",
    "icon": "electron scripts/make-icon.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:localstack": "docker run --rm -d --name bucketeer-localstack -p 4566:4566 -e SERVICES=s3 localstack/localstack && echo \"LocalStack on :4566 — run: S3_TEST_ENDPOINT=http://127.0.0.1:4566 npm test\"",
    "test:minio": "docker run --rm -d --name bucketeer-minio -p 9000:9000 -e MINIO_ROOT_USER=bucketeer -e MINIO_ROOT_PASSWORD=bucketeer123 minio/minio server /data && echo \"MinIO on :9000 — run: S3_TEST_ENDPOINT=http://127.0.0.1:9000 S3_TEST_KEY=bucketeer S3_TEST_SECRET=bucketeer123 npm test\"",
    "test:stop": "docker rm -f bucketeer-localstack bucketeer-minio 2>/dev/null || true",
    "icon:tray": "electron scripts/make-icon.cjs --tray && electron scripts/make-icon.cjs --tray --colour"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.974.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/client-sso-oidc": "^3.1111.0",
    "@aws-sdk/client-sts": "^3.1111.0",
    "@aws-sdk/credential-providers": "^3.1111.0",
    "@aws-sdk/lib-storage": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@tanstack/react-virtual": "^3.14.9",
    "https-proxy-agent": "^9.1.0"
  }
}
