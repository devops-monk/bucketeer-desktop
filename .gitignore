# Dependencies
node_modules/
.pnp
.pnp.js

# Build output — note `build/` is NOT ignored: it holds electron-builder resources.
dist/
out/
release/
*.tsbuildinfo

# Electron
.electron-vite/
*.dmg
*.exe
*.AppImage
*.deb
*.snap
*.zip

# Environment / secrets — never commit AWS credentials
.env
.env.*
!.env.example
*.pem
*.p12
# Anchored: an AWS credentials file dropped at the repo root, not the source directory
# of the same name.
/credentials

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Internal documents dropped into the working tree — never publish these.
*.pdf

# Worktrees Claude Code creates for isolated work; never part of the repository.
.claude/worktrees/
